# WeaveGuard AI - Configuration d'environnement Docker (.env.docker)
# À copier vers .env.docker : cp .env.docker.example .env.docker

# Clé secrète cryptographique HS256 (générer avec: python backend/scripts/generate_secret.py)
JWT_SECRET=generer_une_cle_secrete_de_64_caracteres_avec_generate_secret_py

# Base de données MongoDB (nom de service 'mongo' sur le réseau interne Docker)
MONGODB_URI=mongodb://mongo:27017
DB_NAME=weaveguard

# Chemins dans le conteneur (/app/...)
MODELS_DIR=/app/models
DATASET_DIR=/app/datasets
DTD_DIR=/app/data/images
STORAGE_DIR=/app/storage

# Exécution CPU uniquement
DEVICE=cpu
TORCH_NUM_THREADS=4
INFERENCE_LONG_SIDE=1448
ENGINES_ENABLED=yolo,patchcore,similarity

# Limites de sécurité d'upload
MAX_QUEUE=20
MAX_UPLOAD_MB=50
MAX_IMAGE_SIDE=8000
ALLOWED_FORMATS=jpeg,jpg,png

# Paramètres opérationnels
RETENTION_DAYS=90
ENV=dev

