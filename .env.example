# ============================================================
# WeaveGuard AI — Variables d'environnement
# Copiez ce fichier en .env et renseignez les valeurs.
# NE JAMAIS versionner le fichier .env (voir .gitignore).
# ============================================================

# ----------------------------------------------------------
# Base de données MongoDB
# ----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DB_NAME=weaveguard

# ----------------------------------------------------------
# Sécurité & JWT
# Générez une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------
JWT_SECRET=REMPLACEZ_PAR_UNE_CLE_SECRETE_DE_64_CARACTERES_MINIMUM
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ----------------------------------------------------------
# Exécution & IA
# ----------------------------------------------------------
# Device : auto | cpu | cuda
DEVICE=auto

# Nombre de threads PyTorch pour l'inférence CPU.
# Laisser vide = auto (PyTorch choisit selon os.cpu_count()).
# Benchmarkez avec scripts/benchmark.py pour trouver la valeur optimale.
# Valeur recommandée sur cette machine (12 CPU) : à déterminer par benchmark.
TORCH_NUM_THREADS=

# Côté long maximal pour l'inférence (redimensionnement proportionnel).
# Ne pas modifier sans recalibration complète des moteurs.
INFERENCE_LONG_SIDE=1448

# Moteurs activés (virgule-séparé) : yolo, patchcore, similarity
ENGINES_ENABLED=yolo,patchcore,similarity

# Mode d'échelle par défaut : native (défaut) | normalized (candidat expérimental)
# En normalized, les images inférieures à INFERENCE_LONG_SIDE sont agrandies.
# NE PAS changer à normalized sans évaluation sur val set (voir WP3-A).
SCALE_MODE_DEFAULT=native

# ----------------------------------------------------------
# Limites upload & file d'attente
# ----------------------------------------------------------
MAX_QUEUE=20
MAX_UPLOAD_MB=50
MAX_IMAGE_SIDE=8000
# Extensions autorisées (virgule-séparé)
ALLOWED_FORMATS=jpeg,jpg,png

# ----------------------------------------------------------
# Exploitation, Rétention & Revue
# ----------------------------------------------------------
RETENTION_DAYS=90

# Motifs de rejet autorisés pour les revues humaines
REJECTION_REASONS=artefact_tissage,faux_positif_texture,pli_tissu,couture,ombre_eclairage,autre

# ----------------------------------------------------------
# CORS (origines autorisées pour le frontend en développement)
# ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# Environnement
# ----------------------------------------------------------
# dev | validation | prod
ENV=dev

# ----------------------------------------------------------
# Chemins (relatifs à la racine du projet)
# ----------------------------------------------------------
# Laisser vide pour les valeurs par défaut.
# MODELS_DIR=models
# DATASET_DIR=datasets
# DTD_DIR=data/images
# STORAGE_DIR=backend/storage
# FRONTEND_DIST_DIR=frontend/dist

