# WeaveGuard AI - Configuration d'environnement (.env)
# ====================================================

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=weaveguard

# Sécurité & JWT (HS256)
# Générer avec : python backend/scripts/generate_secret.py
JWT_SECRET=change-this-in-production-use-a-strong-secret-key-at-least-32-chars
JWT_EXPIRE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Chemins des artefacts IA et jeux de données (relatifs à la racine du projet ou absolus)
MODELS_DIR=models
DATASET_DIR=datasets
DTD_DIR=data/images
STORAGE_DIR=backend/storage

# Exécution IA
# DEVICE : auto | cuda | cpu
DEVICE=auto
# INFERENCE_LONG_SIDE : redimensionnement si grand côté > cette valeur (entraînement à ~1448x1086)
INFERENCE_LONG_SIDE=1448
# Moteurs activés globalement (yolo, patchcore, similarity)
ENGINES_ENABLED=yolo,patchcore,similarity

# Limites images
MAX_UPLOAD_MB=50
MAX_IMAGE_SIDE=8000
ALLOWED_FORMATS=jpeg,jpg,png

# Exploitation & politique de conservation
RETENTION_DAYS=90

# Sécurité réseau & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENV=dev

